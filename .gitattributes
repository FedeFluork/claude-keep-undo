# Normalize line endings in the repository; check out native on each platform.
* text=auto eol=lf

# Explicitly binary — never touch these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.vsix binary
*.zip binary

# Keep generated/vendored files out of diffs and language statistics.
package-lock.json linguist-generated=true -diff
out/** linguist-generated=true
